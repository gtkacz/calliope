# Override the host port Postgres is published on if 5432 is already taken.
POSTGRES_HOST_PORT=5432

# Override the host port the backend is published on.
BACKEND_HOST_PORT=8000

# Override the host port the frontend is published on.
FRONTEND_HOST_PORT=5173

# Browser-facing URL the Vue SPA will use to reach the backend.
# Baked into the frontend image at build time — change requires `docker compose build frontend`.
VITE_CALLIOPE_API_BASE_URL=http://localhost:8000

# Optional: override the backend's database URL. The compose file sets a sensible
# default for the in-cluster postgres service; only set this to point at an
# external database.
# CALLIOPE_DATABASE_URL=postgresql+psycopg://calliope:calliope@postgres:5432/calliope

# JSON-encoded list of allowed CORS origins for the backend. Must include every
# host:port the SPA is served from when FRONTEND_HOST_PORT differs from 5173.
# CALLIOPE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Absolute host path the backend can browse, index, and edit. The container
# bind-mounts this directory at the same path (read-write for in-app editing),
# so it's the ONLY part of your host filesystem the in-app folder picker,
# indexer, and LLM file-write API can see, and absolute paths resolve verbatim
# inside the container. Set it as wide as you need:
#   CALLIOPE_BROWSE_ROOT=/home/youruser        # browse anything under your home
#   CALLIOPE_BROWSE_ROOT=/home/youruser/notes  # restrict to a single tree
# Defaults to /var/tmp/calliope-notes (auto-created empty if missing) so the
# stack boots out of the box.
# CALLIOPE_BROWSE_ROOT=/home/youruser

# Opt-in: keep a local git-backed version history of files the app edits. When
# enabled, each versioned workspace gets an isolated .calliope-git store (never
# your own .git) so prior versions can be restored from the editor. Requires the
# `git` binary in the backend image (already included). Off by default.
# CALLIOPE_VERSIONING_ENABLED=true

# Provider API keys for LLM connection profiles. The in-app "Provider" presets
# fill a profile's "API key (env var)" field with one of these names; the value
# set here is forwarded into the backend container and read at request time.
# Leave a key unset to skip that provider — local Ollama / LM Studio need none.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
