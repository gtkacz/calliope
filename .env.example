# Override the host port Postgres is published on if 5432 is already taken.
POSTGRES_HOST_PORT=5432

# Override the host port the backend is published on.
BACKEND_HOST_PORT=8000

# Override the host port the frontend is published on.
FRONTEND_HOST_PORT=5173

# Browser-facing URL the Vue SPA will use to reach the backend.
# Baked into the frontend image at build time — change requires `docker compose build frontend`.
VITE_CALLIOPE_API_BASE_URL=http://localhost:8000

# Optional: override the backend's database URL. The compose file sets a sensible
# default for the in-cluster postgres service; only set this to point at an
# external database.
# CALLIOPE_DATABASE_URL=postgresql+psycopg://calliope:calliope@postgres:5432/calliope

# JSON-encoded list of allowed CORS origins for the backend. Must include every
# host:port the SPA is served from when FRONTEND_HOST_PORT differs from 5173.
# CALLIOPE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Absolute host path to a directory containing markdown notes. The backend
# container mounts this at the same path (read-only), so absolute paths pasted
# into "Workspace root" in the UI resolve verbatim inside the container.
# Defaults to /var/tmp/calliope-notes (auto-created empty if missing) so the
# stack boots out of the box; set this to point at your real notes tree.
# CALLIOPE_NOTES_DIR=/home/youruser/notes
